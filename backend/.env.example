# Redis URL (Optional - in-memory/disk cache used automatically if Redis is not running)
REDIS_URL=redis://localhost:6379

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Authentication & Database
JWT_SECRET=vibemusic_super_secure_jwt_secret_key_2026_9837a6b4c12

# Spotify Developer API (Get free at https://developer.spotify.com/dashboard)
# 1. Create an app in Spotify Developer Dashboard
# 2. Add Redirect URI: http://localhost:3000/auth/spotify/callback
# 3. Paste Client ID and Secret below
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/spotify/callback

# Supabase Cloud Database & Auth (Optional - falls back to local SQLite if empty)
# Get your free Project URL & Keys from: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
